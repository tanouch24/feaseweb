# Supabase public values (safe for the browser; RLS remains mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only values. Never use NEXT_PUBLIC_ for this key and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# Stripe — configured LIVE for the current billing deployment. Never commit a real key.
STRIPE_SECRET_KEY=rk_live_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_live_price_id

# Base URL used to build Stripe Checkout/Portal success and cancel links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
